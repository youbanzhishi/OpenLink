[Unit]
Description=OpenLink - AI Agent Interconnection Protocol
After=network.target

[Service]
Type=simple
User=openlink
Group=openlink
WorkingDirectory=/opt/openlink
Environment=OPENLINK_CONFIG=/opt/openlink/config/production.toml
Environment=RUST_LOG=info
ExecStart=/opt/openlink/bin/openlink-api
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
